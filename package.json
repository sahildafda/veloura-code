{
  "name": "veloura-code",
  "version": "1.0.0",
  "description": "Autonomous AI coding agent with ChatGPT-style Web UI and local-first privacy, powered by OpenRouter",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "veloura": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "PRIVACY.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.tsx",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahildafda/veloura-code.git"
  },
  "bugs": {
    "url": "https://github.com/sahildafda/veloura-code/issues"
  },
  "homepage": "https://github.com/sahildafda/veloura-code#readme",
  "keywords": [
    "ai",
    "coding-agent",
    "autonomous",
    "cli",
    "openrouter",
    "opencode",
    "claude-code",
    "developer-tools",
    "typescript",
    "agentic-ai"
  ],
  "author": "Sahil Dafda <20bmiit042@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "diff": "^7.0.0",
    "fast-glob": "^3.3.3",
    "figures": "^6.1.0",
    "ignore": "^7.0.3",
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.85.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^18.3.1",
    "simple-git": "^3.27.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cross-spawn": "^6.0.6",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
